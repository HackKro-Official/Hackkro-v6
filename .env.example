# ==============================================================================
# HackKro Platform v3.0 — Environment Variables Template
# Copy this file to .env and fill in real values before running in production.
# NEVER commit real secrets or API keys to version control.
# ==============================================================================

# --- Database (Prisma) ---
# Local zero-config development uses SQLite:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://hackkro_user:CHANGE_ME@localhost:5432/hackkro?schema=public"

# --- Security & Sessions ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="replace-with-at-least-64-char-cryptographically-random-secret"
JWT_SECRET="replace-with-separate-64-char-secret-for-legacy-and-signed-tokens"
WEBHOOK_SIGNING_SECRET="replace-with-hmac-secret-for-outgoing-webhooks"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000"

# --- Auth Mode & OAuth2 / OIDC ---
# Set to "development" for sandboxed/local OTP inspection banner & dev test endpoints, "production" otherwise.
APP_ENV="development"
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/v1/auth/oauth/google/callback"

# --- Email / SMTP Adapter ---
# Leave blank to run in clearly-labeled development outbox mode (persisted to Notification/EmailOutbox log).
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="HackKro <no-reply@hackkro.local>"

# --- SMS / OTP Adapter ---
# Supported adapters: "sandbox" (default when credentials unset) | "twilio" | "msg91"
SMS_PROVIDER="sandbox"
SMS_API_KEY=""
SMS_SENDER_ID="HACKKR"

# --- Payment Gateway Adapter ---
# Supported modes: "sandbox" (explicit test mode with signed webhook verification) | "razorpay" | "stripe"
PAYMENT_PROVIDER="sandbox"
PAYMENT_KEY_ID=""
PAYMENT_KEY_SECRET=""
PAYMENT_WEBHOOK_SECRET="sandbox_webhook_secret_change_in_prod"

# --- File Storage & Malware Scan Adapter ---
# Supported modes: "local_private" (encrypted/quarantined local dir outside public/) | "s3"
STORAGE_PROVIDER="local_private"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
FILE_SIGNING_SECRET="replace-with-signed-download-url-secret"

# --- Code Execution Sandbox ---
# Supported modes: "isolated_vm_sandbox" (resource/timeout-guarded runner) | "judge0"
CODE_SANDBOX_MODE="isolated_vm_sandbox"
JUDGE0_API_URL=""
JUDGE0_API_KEY=""

# --- Legacy Optional MongoDB (Unused after Prisma migration) ---
MONGODB_URI=""
